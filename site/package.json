{
  "name": "awesome-chip-agents-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "python3 ../scripts/export_site.py",
    "dev": "npm run data && vite --host 0.0.0.0",
    "build": "npm run data && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs && node scripts/check-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
